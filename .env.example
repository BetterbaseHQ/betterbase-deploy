# Betterbase Production Environment
# Copy to .env and fill in values before running docker compose up

# ==========================================================================
# OPAQUE Authentication Keys (generate with betterbase-accounts keygen)
# ==========================================================================
OPAQUE_SERVER_SETUP=

# ==========================================================================
# OAuth Issuer (your accounts server public URL)
# For production, use: https://accounts.yourdomain.com
# ==========================================================================
OAUTH_ISSUER=http://localhost:5377

# ==========================================================================
# Sync endpoint advertised in discovery metadata
# For production, use: https://sync.yourdomain.com/api/v1
# ==========================================================================
SYNC_ENDPOINT=http://localhost:5379/api/v1

# ==========================================================================
# CAP (Proof-of-Work CAPTCHA)
# ==========================================================================
CAP_ADMIN_KEY=
CAP_KEY_ID=
CAP_SECRET=

# ==========================================================================
# Identity Hash Key (HMAC-SHA256 for privacy-preserving identity hashing)
# Generate: openssl rand -hex 32
# ==========================================================================
IDENTITY_HASH_KEY=

# ==========================================================================
# Database credentials
# setup.sh generates random passwords; uncomment to set your own
# ==========================================================================
# ACCOUNTS_DB_USER=accounts
# ACCOUNTS_DB_PASSWORD=accounts
# ACCOUNTS_DB_NAME=accounts
# SYNC_DB_USER=sync
# SYNC_DB_PASSWORD=sync
# SYNC_DB_NAME=sync

# ==========================================================================
# SMTP (outbound email for verification and recovery)
# Default: dev mode — emails are logged instead of sent (fine for a
# playground). For production email set SMTP_DEV_MODE=false and configure a
# real SMTP host; the accounts server fails startup without one.
# ==========================================================================
SMTP_DEV_MODE=true
# SMTP_HOST=smtp.yourdomain.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@yourdomain.com

# ==========================================================================
# Samples (hosted example apps)
# setup.sh provisions the OAuth clients; redirect URIs follow SAMPLES_SITE:
# https://samples.yourdomain.com/<app>/ in TLS mode, http://localhost:5380/<app>/
# otherwise. ENABLED_APPS accepts a space- or comma-separated list.
# ==========================================================================
# SAMPLES_SITE=samples.yourdomain.com
# SAMPLES_ACCOUNTS_DOMAIN=accounts.yourdomain.com
# SAMPLES_PORT=5380
# ENABLED_APPS=tasks notes photos board chat passwords
# LAUNCHPAD_CLIENT_ID=
# TASKS_CLIENT_ID=
# NOTES_CLIENT_ID=
# PHOTOS_CLIENT_ID=
# BOARD_CLIENT_ID=
# CHAT_CLIENT_ID=
# PASSWORDS_CLIENT_ID=

# ==========================================================================
# Public TLS (managed by ./setup.sh --domain; leave unset for localhost)
# With --domain yourdomain.com, Caddy serves https://accounts.yourdomain.com
# and https://sync.yourdomain.com with automatic Let's Encrypt certificates.
# Requires DNS A records for both subdomains and ports 80+443 reachable.
# ==========================================================================
# ACCOUNTS_SITE=accounts.yourdomain.com
# SYNC_SITE=sync.yourdomain.com
# ACME_EMAIL=you@yourdomain.com
# HTTP_PORT=80
# HTTPS_PORT=443

# ==========================================================================
# Port mapping for localhost mode (inert when ACCOUNTS_SITE/SYNC_SITE are set)
# ==========================================================================
# ACCOUNTS_PORT=5377
# SYNC_PORT=5379
